# Postgres
POSTGRES_USER=wyldetrace
POSTGRES_PASSWORD=wyldetrace
POSTGRES_DB=wyldetrace
DATABASE_URL=postgres://wyldetrace:wyldetrace@db:5432/wyldetrace?sslmode=disable

# API
HTTP_ADDR=:8080
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=admin@wyldetech.local
ADMIN_PASSWORD=changeme

# Session JWTs use a fixed 24h TTL (see docs/SECURITY.md).

# Lab mode: optional secrets encryption, wildcard CORS, and http outbound URLs.
# Set false (or unset) for production.
WYLDTRACE_DEV=true

# AES-256 key for MFA/integration secrets at rest (64 hex chars). Required when WYLDTRACE_DEV=false.
# SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional scrape auth for GET /metrics
# METRICS_TOKEN=
# Production: comma-separated SPA origins (wildcard rejected when WYLDTRACE_DEV=false)
# CORS_ORIGINS=https://ipam.example.com

# Public SPA URL (OIDC post-login redirect target)
PUBLIC_APP_URL=http://localhost:5173

# Optional OIDC / SSO (disabled by default)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
OIDC_SCOPES=openid,profile,email
OIDC_DEFAULT_ROLE=readonly
OIDC_AUTO_PROVISION=true
# Groups claim + map (role:group1|group2,...). Highest mapped role wins.
OIDC_GROUPS_CLAIM=groups
OIDC_ROLE_CLAIM=role
# Example: OIDC_ROLE_MAP=admin:wt-admins|net-admins,editor:wt-editors,readonly:users,reportview:wt-reports
OIDC_ROLE_MAP=
# When true, update existing local user role from IdP on each login
OIDC_SYNC_ROLE=false
